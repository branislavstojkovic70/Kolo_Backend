generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ListingStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
  // held for an auto-buy buyer until reservedUntil — invisible in the public
  // feed and not manually buyable while in this state
  RESERVED
  // an auto-buy order on this listing was paid
  SOLD
  DELETED
}

enum BuyRequestStatus {
  ACTIVE
  MATCHED
  FULFILLED
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  DISPUTED
  REFUNDED
  EXPIRED
}

enum DisputeStatus {
  OPEN
  RESOLVED_BUYER
  RESOLVED_SELLER
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// The predefined catalog — sellers can only list products that exist here.
// Rows come from prisma/products.json, upserted by slug on every boot
// (ProductsService.onModuleInit), so the catalog is code-managed, never user input.
model Product {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  category       String
  retailPriceUsd Decimal @db.Decimal(18, 2) // official/regular price
  imageUrl       String?
  active         Boolean @default(true)

  listings    Listing[]
  orders      Order[]
  buyRequests BuyRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String  @id @default(cuid())
  clerkUserId      String  @unique // subject from the Clerk JWT
  email            String  @unique
  username         String? // display name
  imageUrl         String?
  telegramUsername String? // informational only — shown in the dispute group's
  // opening message. NOT used to add anyone to a group.
  role             Role    @default(USER)

  listings         Listing[]
  reservedListings Listing[]    @relation("reservedListings")
  buyRequests      BuyRequest[]
  purchases        Order[]      @relation("buyer")
  sales            Order[]      @relation("seller")
  beneficiaryOf    Order[]      @relation("beneficiary")
  withdrawals      Withdrawal[]
  openedDisputes   Dispute[]    @relation("openedBy")
  resolvedDisputes Dispute[]    @relation("resolvedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Listing {
  id           String        @id @default(cuid())
  sellerId     String
  seller       User          @relation(fields: [sellerId], references: [id])
  // the catalog entry this listing sells — immutable after creation
  productId    String
  product      Product       @relation(fields: [productId], references: [id])
  // title/category are COPIED from the product at write time so every existing
  // response shape stays identical for the FE. Never user input anymore.
  title        String
  description  String
  category     String?
  // cover art shown on the marketplace card and the detail page — a plain
  // external URL, no upload/hosting on our side
  imageUrl     String?
  priceUsd     Decimal       @db.Decimal(18, 2)
  // shown to the buyer only after payment (credentials, instructions, contact)
  deliveryInfo String?
  // how many times this can be sold, and how many units are already claimed.
  // A unit is claimed the moment an order is created and released if it expires;
  // soldCount == quantity flips the listing to SOLD_OUT and off the marketplace.
  quantity     Int           @default(1)
  soldCount    Int           @default(0)
  status       ListingStatus @default(ACTIVE)
  // auto-buy reservation: who the listing is held for and until when. Set when a
  // BuyRequest matches, cleared on payment (→ SOLD) or expiry (→ back to ACTIVE).
  reservedUntil DateTime?
  reservedForId String?
  reservedFor   User?         @relation("reservedListings", fields: [reservedForId], references: [id])
  orders       Order[]
  buyRequests  BuyRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([sellerId])
}

model Order {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User    @relation("buyer", fields: [buyerId], references: [id])
  sellerId  String
  seller    User    @relation("seller", fields: [sellerId], references: [id])

  // snapshot at purchase time — listing may change later
  titleSnapshot   String
  // catalog product + its retail price AT PURCHASE TIME. Savings are always
  // computed from this snapshot, never from the live catalog (prices change).
  productId              String
  product                Product @relation(fields: [productId], references: [id])
  retailPriceUsdSnapshot Decimal @db.Decimal(18, 2)
  amountUsd       Decimal @db.Decimal(18, 2) // what the buyer pays
  feeUsd          Decimal @db.Decimal(18, 2) // platform fee
  sellerAmountUsd Decimal @db.Decimal(18, 2) // amount - fee = escrowed amount

  status OrderStatus @default(PENDING_PAYMENT)

  // who is allowed to withdraw sellerAmountUsd (seller by default, buyer if he wins a dispute)
  beneficiaryId String
  beneficiary   User   @relation("beneficiary", fields: [beneficiaryId], references: [id])

  oxapayTrackId String?   @unique
  paymentUrl    String?
  paidAt        DateTime?
  vestedAt      DateTime? // paidAt + VESTING_DAYS

  withdrawalId String?
  withdrawal   Withdrawal? @relation(fields: [withdrawalId], references: [id])

  dispute Dispute?

  // the buy request this order fulfils, if it came from auto-buy
  buyRequests BuyRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([beneficiaryId, status])
}

model Dispute {
  id         String        @id @default(cuid())
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id])
  openedById String
  openedBy   User          @relation("openedBy", fields: [openedById], references: [id])
  reason     String
  status     DisputeStatus @default(OPEN)

  telegramChatId     String? // group id returned by MTProto (store as string, it can change)
  telegramInviteLink String? // durable handle, shown to buyer & seller in the UI

  resolvedById   String?
  resolvedBy     User?     @relation("resolvedBy", fields: [resolvedById], references: [id])
  resolutionNote String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  amountUsd     Decimal          @db.Decimal(18, 2)
  currency      String           @default("USDT")
  network       String // TRC20 / BEP20 / TON ...
  address       String
  status        WithdrawalStatus @default(PENDING)
  oxapayTrackId String?          @unique
  error         String?
  completedAt   DateTime?
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A standing wish: "buy <product> the moment someone lists it at or under maxPriceUsd".
// Matching is synchronous at listing/request creation; a cron only cleans up expired
// reservations and re-matches. The buyer still pays through OxaPay like any order —
// there is no internal deposit balance.
model BuyRequest {
  id          String           @id @default(cuid())
  buyerId     String
  buyer       User             @relation(fields: [buyerId], references: [id])
  productId   String
  product     Product          @relation(fields: [productId], references: [id])
  maxPriceUsd Decimal          @db.Decimal(18, 2)
  status      BuyRequestStatus @default(ACTIVE)
  // optional, buyer-set: the wish lapses on its own after this
  expiresAt   DateTime?

  matchedListingId String?
  matchedListing   Listing?  @relation(fields: [matchedListingId], references: [id])
  matchedOrderId   String?
  matchedOrder     Order?    @relation(fields: [matchedOrderId], references: [id])
  matchedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([buyerId, createdAt])
}

// idempotency guard for OxaPay callbacks
model WebhookEvent {
  id       String @id @default(cuid())
  provider String @default("oxapay")
  type     String // payment | payout
  trackId  String
  status   String
  payload  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, type, trackId, status])
}
